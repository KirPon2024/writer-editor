    "build:renderer": "node scripts/build-renderer.mjs",
    "build:renderer:watch": "node scripts/build-renderer.mjs --watch",
    "r24:test-inventory": "node scripts/ops/r24/test-inventory.mjs --check docs/OPS/R24/CORRECTIVE/C1B_TEST_INVENTORY_V1.json",

{
  "title": "Yalken Task Architecture Declaration V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "objective",
    "taskType",
    "bindingBaseSha",
    "scopeIn",
    "scopeOut",
    "productAuthority",
    "commandAuthority",
    "designAuthority",
    "operationKinds",
    "writePaths",
    "readPaths",
    "productPorts",
    "designOsPorts",
    "readProjections",
    "stateClasses",
    "identityGuards",
    "capabilityRevalidation",
    "fallbacks",
    "recoveryAndNegativeChecks",
    "securityAndInputBoundary",
    "performanceAndAccessibility",
    "currentReality",
    "targetOnly",
    "designToolRouter",
    "dependenciesAndNetwork",
    "deliveryPolicy",
    "rollbackPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 3
    },
    "objective": {
      "type": "string",
      "minLength": 3
    },
    "taskType": {
      "enum": [
        "REPORT_ONLY",
        "DOCS_ONLY",
        "PRODUCT_CODE",
        "PRODUCT_UI",
        "OPS_GOVERNANCE",
        "HYGIENE_ISOLATION"
      ]
    },
    "bindingBaseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "scopeIn": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\*)(?!.*\\\\).+$"
      }
    },
    "scopeOut": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\*)(?!.*\\\\).+$"
      }
    },
    "productAuthority": {
      "type": "string",
      "minLength": 1
    },
    "commandAuthority": {
      "type": "string",
      "minLength": 1
    },
    "designAuthority": {
      "type": "string",
      "minLength": 1
    },
    "operationKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "COMMAND",
          "QUERY",
          "EVENT",
          "EFFECT",
          "BACKGROUND_JOB",
          "PROJECTION",
          "NOT_APPLICABLE_DOCS_ONLY",
          "NOT_APPLICABLE_REPORT_ONLY"
        ]
      }
    },
    "writePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "productPorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "designOsPorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readProjections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stateClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "PROJECT_STATE",
          "AUTHORING_WORKING_STATE",
          "DERIVED_STATE",
          "SHELL_STATE",
          "TRANSIENT_STATE",
          "NOT_APPLICABLE_DOCS_ONLY",
          "NOT_APPLICABLE_REPORT_ONLY"
        ]
      }
    },
    "identityGuards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilityRevalidation": {
      "type": "string",
      "minLength": 1
    },
    "fallbacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recoveryAndNegativeChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "securityAndInputBoundary": {
      "type": "string",
      "minLength": 1
    },
    "performanceAndAccessibility": {
      "type": "string",
      "minLength": 1
    },
    "currentReality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetOnly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "designToolRouter": {
      "enum": [
        "NOT_APPLICABLE",
        "APPLICABLE_LAZYWEB_FIRST"
      ]
    },
    "dependenciesAndNetwork": {
      "type": "string",
      "minLength": 1
    },
    "deliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitRequired",
        "pushRequired",
        "prRequired",
        "mergeRequired",
        "postMergeExactHeadVerificationRequired"
      ],
      "properties": {
        "commitRequired": {
          "type": "boolean"
        },
        "pushRequired": {
          "type": "boolean"
        },
        "prRequired": {
          "type": "boolean"
        },
        "mergeRequired": {
          "type": "boolean"
        },
        "postMergeExactHeadVerificationRequired": {
          "type": "boolean"
        }
      }
    },
    "rollbackPlan": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "name": "craftsman",
  "version": "1.0.2",
  "description": "Бесплатный аскетичный редактор для писателей",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predev": "npm run build:renderer",
    "dev": "node -e \"const { existsSync } = require('node:fs'); const { execSync, spawnSync } = require('node:child_process'); if (!existsSync('dist/renderer/editor.bundle.js')) { execSync('node scripts/build-renderer.mjs',{stdio:'inherit'}); } const electron = require('electron'); const env = { ...process.env }; delete env.ELECTRON_RUN_AS_NODE; const result = spawnSync(electron, ['.', '--dev'], { stdio: 'inherit', env }); if (result.error) { console.error(result.error); process.exit(1); } const status = typeof result.status === 'number' ? result.status : 1; process.exit(status);\"",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:renderer:watch": "node scripts/build-renderer.mjs --watch",
    "test:ops": "npm run -s ops:current-wave",
    "test:toolbar-closeout": "node scripts/run-tests.js closeout",
    "test:sector-m": "node --test test/unit/sector-m-*.test.js",
    "test:sector-u": "node --test test/unit/sector-u-*.test.js",
    "test:sector-u-full": "npm run test:sector-u && node -e \"const fs = require('node:fs'); const { spawnSync } = require('node:child_process'); const files = fs.readdirSync('test/unit').filter((name) => /^sector-u-u[67]-.*\\\\.test\\\\.js$/.test(name)).sort().map((name) => 'test/unit/' + name); if (files.length === 0) { console.error('No Sector U full test files found'); process.exit(1); } const r = spawnSync(process.execPath, ['--test', ...files], { stdio: 'inherit', env: { ...process.env, SECTOR_U_FULL_A11Y: '1', SECTOR_U_FULL_VISUAL: '1' } }); process.exit(typeof r.status === 'number' ? r.status : 1);\"",
    "dev:fast": "node -e \"const { spawnSync } = require('node:child_process'); const env = { ...process.env, DEV_FAST_LANE: '1' }; const r = spawnSync(process.execPath, ['scripts/run-tests.js', 'fast'], { stdio: 'inherit', env }); process.exit(typeof r.status === 'number' ? r.status : 1);\"",
    "perf:lite": "node scripts/perf/perf-lite.mjs",
    "perf:baseline:update": "node scripts/perf/perf-baseline.mjs update",
    "perf:baseline:check": "node scripts/perf/perf-baseline.mjs check",
    "test": "npm run -s test:ops && node scripts/run-tests.js",
    "test:rtk": "node scripts/run-rtk-tests.mjs",
    "test:atlas-event-contract": "node scripts/run-tests.js test/contracts/collab-apply-no-network-wiring.contract.test.js test/contracts/collab-apply-pipeline-deterministic.contract.test.js test/contracts/collab-apply-pipeline-typed-errors.contract.test.js test/contracts/yalken-atlas-v5-e07-c03-language-tag-author-truth-mixed-range-router.contract.test.js test/contracts/yalken-atlas-v5-e10-c03-operation-replay-command-event-log.contract.test.js test/contracts/yalken-atlas-v5-final-audit-p0-01-future-schema-loss.contract.test.js test/contracts/yalken-atlas-v5-final-audit-p0-04-design-os-binding.contract.test.js test/contracts/yalken-atlas-v5-final-audit-p0-05-manual-map-portability.contract.test.js test/contracts/yalken-atlas-v5-p1-domain-event-contract-repair.contract.test.js test/contracts/yalken-atlas-v5-stage10-pr1391-audit-repair.contract.test.js test/contracts/yalken-atlas-v6-audit-hold-repair.contract.test.js test/contracts/yalken-atlas-v6-a3-bounded-repair.contract.test.js test/contracts/yalken-atlas-v6-production-negative.contract.test.js",
    "test:atlas-release-truth": "node scripts/run-tests.js test/contracts/yalken-atlas-v5-final-audit-p0-01-future-schema-loss.contract.test.js test/contracts/yalken-atlas-v5-final-audit-p0-03-packaged-visible-journey.contract.test.js test/contracts/yalken-atlas-v5-efinal-final-audit-program-dod.contract.test.js test/contracts/yalken-atlas-v6-a3-bounded-repair.contract.test.js test/contracts/yalken-atlas-v6-production-negative.contract.test.js",
    "test:atlas-v6-production": "node scripts/ops/yalken-atlas-v6-production-lifecycle.mjs --negative-matrix",
    "test:atlas-graph": "node scripts/run-tests.js test/contracts/yalken-atlas-v5-e04-c06-atlas-local-graph-cluster-layout-budget-proof.contract.test.js test/contracts/yalken-atlas-v5-e08-c01-global-composite-graph-read-model-source-isolation.contract.test.js test/contracts/yalken-atlas-v5-e08-c02-global-graph-on-demand-idle-scheduler-stale-discard.contract.test.js test/contracts/yalken-atlas-v5-e08-c03-advanced-lod-stable-positions-large-graph-budget.contract.test.js",
    "test:performance": "npm run -s perf:baseline:check && node scripts/run-tests.js test/contracts/perf-ci-promotion-mode.contract.test.js test/contracts/perf-runner-deterministic.contract.test.js test/contracts/yalken-atlas-v5-e08-c03-advanced-lod-stable-positions-large-graph-budget.contract.test.js",
    "promotion:check": "npm run -s test:ops && npm run -s test:rtk && node scripts/run-tests.js --mode=promotion",
    "test:electron": "node scripts/run-tests.js electron",
    "sector:u:run": "node scripts/sector-u-run.mjs",
    "oss:policy": "node scripts/check-no-paid-tiptap.mjs",
    "design-os:doctrine": "node scripts/check-design-os-integration-doctrine.mjs",
    "rtk:word:c5v2:physical-canary": "node scripts/ops/rtk-word-c5v2-physical-canary.mjs",
    "rtk:word:c5v2:accessibility-preflight": "node scripts/ops/rtk-word-c5v2-physical-canary.mjs --accessibility-preflight-only",
    "agent:policy": "node scripts/validate-agent-cost-policy.mjs",
    "agent:repo-map": "node scripts/build-agent-repo-map.mjs",
    "agent:packet": "node scripts/build-stage-task-packet.mjs",
    "agent:run": "node scripts/run-cheap-agent.mjs",
    "security:audit:generic-sast": "node semgrep-generic-sast.mjs",
    "ops:mvp-boundary": "node scripts/guards/ops-mvp-boundary.mjs",
    "ops:current-wave": "node scripts/guards/ops-current-wave-stop.mjs",
    "brain:status": "node scripts/brain.mjs status",
    "brain:handoff": "node scripts/brain.mjs handoff",
    "brain:log": "node scripts/brain.mjs log",
    "brain:new-task": "node scripts/brain.mjs new-task",
    "brain:savepoint": "node scripts/brain.mjs savepoint",
    "brain:refs": "node scripts/brain.mjs refs",
    "icons:mac": "bash scripts/make-mac-icon.sh",
    "build": "electron-builder",
    "prebuild:mac": "npm run build:renderer",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "editor",
    "writer",
    "text"
  ],
  "author": "Yalken Contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/KirPon2024/writer-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/KirPon2024/writer-editor.git"
  },
  "dependencies": {
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-color": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1"
  },
  "devDependencies": {
    "electron": "^40.9.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10",
    "linkify-it": "5.0.2",
    "picomatch": "4.0.4",
    "plist": "3.1.1",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.kirpon.writereditor",
    "productName": "Yalken",
    "afterPack": "scripts/after-pack.cjs",
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionAllowsInsecureHTTPSLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "1.3",
              "NSTemporaryExceptionRequiresForwardSecrecy": true
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionAllowsInsecureHTTPSLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "1.3",
              "NSTemporaryExceptionRequiresForwardSecrecy": true
            }
          }
        }
      }
    }
  }
}

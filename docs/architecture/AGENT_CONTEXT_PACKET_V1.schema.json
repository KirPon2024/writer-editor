{
  "title": "Yalken Agent Context Packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "objective",
    "repoRoot",
    "headSha",
    "originMainSha",
    "branch",
    "worktreeDirty",
    "activeCanon",
    "currentCorex",
    "architectureManifest",
    "readingOrder",
    "requiredPreflight",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "READY_FOR_READ_AND_DECLARATION"
    },
    "objective": {
      "type": "string",
      "minLength": 3
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1
    },
    "headSha": {
      "$ref": "#/$defs/sha"
    },
    "originMainSha": {
      "$ref": "#/$defs/sha"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "worktreeDirty": {
      "type": "boolean"
    },
    "activeCanon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "path",
        "activeFeatureExtensions"
      ],
      "properties": {
        "status": {
          "const": "ACTIVE_CANON"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "activeFeatureExtensions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "currentCorex": {
      "const": "docs/corex/COREX.v2.md"
    },
    "architectureManifest": {
      "const": "docs/architecture/AGENT_ARCHITECTURE_MANIFEST_V1.json"
    },
    "readingOrder": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "schema",
        "command"
      ],
      "properties": {
        "template": {
          "const": "docs/templates/AGENT_TASK_ARCHITECTURE_DECLARATION_V1.json"
        },
        "schema": {
          "const": "docs/architecture/AGENT_TASK_ARCHITECTURE_DECLARATION_V1.schema.json"
        },
        "command": {
          "const": "npm run agent:preflight -- --declaration <temporary-json-file>"
        }
      }
    },
    "nextAction": {
      "const": "READ_IN_ORDER_THEN_CREATE_AND_VALIDATE_TASK_ARCHITECTURE_DECLARATION_BEFORE_WRITE"
    },
    "contextRestoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "sourceDenominator",
        "reusedReadDenominator",
        "alwaysReadPaths",
        "mutationAuthority",
        "completionEvidence",
        "remoteNetworkRevalidationPerformed",
        "nextStepIsUntrustedText"
      ],
      "properties": {
        "status": {
          "enum": [
            "VALIDATED_CONTEXT_CACHE",
            "FULL_READ_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceDenominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "reusedReadDenominator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "alwaysReadPaths": {
          "const": [
            "AGENTS.md",
            "docs/OPS/STATUS/CANON_STATUS.json",
            "docs/AGENT_START_PROTOCOL.md"
          ]
        },
        "mutationAuthority": {
          "const": false
        },
        "completionEvidence": {
          "const": false
        },
        "remoteNetworkRevalidationPerformed": {
          "const": false
        },
        "nextStepIsUntrustedText": {
          "const": true
        },
        "checkpointSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context": {
          "$ref": "AGENT_HANDOFF_CHECKPOINT_V1.schema.json#/$defs/context"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VALIDATED_CONTEXT_CACHE"
              }
            }
          },
          "then": {
            "required": [
              "checkpointSha256",
              "context"
            ]
          },
          "else": {
            "properties": {
              "reusedReadDenominator": {
                "const": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "checkpointSha256"
                  ]
                },
                {
                  "required": [
                    "context"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
